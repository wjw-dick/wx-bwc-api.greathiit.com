# ============================================================================
# 校园保卫 SaaS · 环境变量样例
# 复制为 deploy/.env（Docker Compose）或 /etc/bwc/bwc.env（systemd）
# 所有密钥请使用随机值，禁止直接用于生产。
# ============================================================================

# ---------- 基础 ----------
SERVER_PORT=8080
PUBLIC_BASE_URL=https://wx-bwc-api.greathiit.com
TZ=Asia/Shanghai

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bwc
DB_USERNAME=root
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# ---------- RabbitMQ ----------
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=bwc
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
# 未部署 RabbitMQ 时保持 false，通知自动降级为站内消息
BWC_MQ_LISTENER=false

# ---------- 安全密钥（务必更换） ----------
JWT_SECRET=please-change-this-jwt-secret-to-a-long-random-string
JWT_EXPIRE_HOURS=24
AES_KEY=please-change-this-aes-key-to-a-long-random-string

# ---------- 上传 / 对象存储 ----------
UPLOAD_PATH=./uploads
UPLOAD_MAX_MB=20
# local / s3 / oss / cos / minio，实际驱动在后台“对象存储”页配置
STORAGE_DRIVER=local

# MinIO（如启用）
MINIO_ROOT_USER=bwcadmin
MINIO_ROOT_PASSWORD=change-me-please
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=bwc
MINIO_ACCESS_KEY=bwcadmin
MINIO_SECRET_KEY=change-me-please

# ---------- 微信 ----------
WX_MP_APP_ID=
WX_MP_APP_SECRET=
WX_MINI_APP_ID=
WX_MINI_APP_SECRET=
WX_MINI_UNIONID_ENABLED=false

# ---------- 车牌识别 ----------
PLATE_TIMEOUT_SECONDS=8
PLATE_BASE_URL=
PLATE_API_KEY=

# ---------- PDF 中文字体 ----------
# 将可用的中文 TTF 挂载到该路径；容器内默认读取 /usr/share/fonts/chinese/stsong.ttf
BWC_PDF_FONT=/usr/share/fonts/chinese/stsong.ttf

# ---------- Docker Web ----------
WEB_PORT=8088
