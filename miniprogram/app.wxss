page {
  background: #f6f9fe;
  color: #16233a;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container { padding: 24rpx 28rpx 48rpx; }
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e6edf6;
  box-shadow: 0 8rpx 24rpx rgba(15, 42, 82, 0.04);
  margin-bottom: 22rpx;
}
.row { display: flex; align-items: center; }
.between { display: flex; align-items: center; justify-content: space-between; }
.gap { gap: 16rpx; }
.flex1 { flex: 1; min-width: 0; }
.muted { color: #7b8ca6; font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 700; color: #0f2a52; }
.subtitle { color: #7b8ca6; font-size: 24rpx; margin-top: 6rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #0f2a52; margin: 10rpx 0 18rpx; }
.divider { height: 1rpx; background: #eef3fa; margin: 20rpx 0; }

.btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 999rpx; font-size: 30rpx; font-weight: 600;
  background: #2563eb; color: #fff; border: none;
}
.btn::after { border: none; }
.btn.ghost { background: #eef4ff; color: #2563eb; }
.btn.outline { background: #fff; border: 1rpx solid #dbe5f2; color: #334155; }
.btn.danger { background: #ef4444; }
.btn.small { height: 64rpx; font-size: 24rpx; padding: 0 28rpx; display: inline-flex; }
.btn.block { width: 100%; }
.btn[disabled] { opacity: 0.55; }

.tag {
  display: inline-flex; align-items: center; padding: 4rpx 16rpx; border-radius: 999rpx;
  font-size: 22rpx; background: #eef4ff; color: #2563eb;
}
.tag.ok { background: #e6f8f0; color: #0f9d63; }
.tag.warn { background: #fff4dd; color: #c47a06; }
.tag.danger { background: #fff1f2; color: #be123c; }
.tag.muted { background: #f1f5f9; color: #64748b; }

.field { margin-bottom: 24rpx; }
.field .label { font-size: 26rpx; color: #334155; margin-bottom: 10rpx; }
.field .label .required { color: #ef4444; margin-left: 4rpx; }
.field input, .field textarea, .field picker, .field .picker-value {
  width: 100%; background: #fbfdff; border: 1rpx solid #dbe5f2; border-radius: 16rpx;
  font-size: 28rpx; color: #16233a; box-sizing: border-box;
}
/* 小程序 input 默认高度较小，必须显式设置高度和行高，否则文字会被上下裁切 */
.field input {
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 22rpx;
}
.field textarea {
  height: 180rpx;
  line-height: 1.6;
  padding: 20rpx 22rpx;
}
.field picker {
  padding: 0;
  border: none;
  background: transparent;
}
.field .picker-value {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 22rpx;
}
.field .hint { font-size: 22rpx; color: #94a3b8; margin-top: 8rpx; }

.list-item {
  background: #fff; border-radius: 20rpx; padding: 24rpx; border: 1rpx solid #e6edf6;
  margin-bottom: 16rpx;
}
.list-item .top { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.list-item h3 { font-size: 30rpx; margin: 0; color: #0f2a52; }
.list-item p { margin: 8rpx 0 0; color: #7b8ca6; font-size: 24rpx; }
.meta-line { display: flex; flex-wrap: wrap; gap: 10rpx 24rpx; color: #94a3b8; font-size: 22rpx; margin-top: 12rpx; }

.empty { text-align: center; color: #94a3b8; padding: 80rpx 0; font-size: 26rpx; }
.loading { text-align: center; color: #94a3b8; padding: 40rpx 0; font-size: 24rpx; }
.error-text { color: #be123c; font-size: 24rpx; margin: 8rpx 0; }

.hero {
  background: linear-gradient(145deg, #0b2547, #123a6d);
  color: #fff; padding: 36rpx 32rpx 46rpx; border-radius: 0 0 36rpx 36rpx;
}
.hero h1 { font-size: 42rpx; margin: 0 0 8rpx; }
.hero p { margin: 0; color: #c7d7ee; font-size: 24rpx; }
.hero .badge {
  display: inline-block; background: rgba(255,255,255,0.12); border: 1rpx solid rgba(255,255,255,0.2);
  border-radius: 999rpx; padding: 4rpx 18rpx; font-size: 22rpx; margin-bottom: 14rpx;
}

.stat-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: -28rpx; }
.stat-card {
  flex: 1 1 40%; background: #fff; border-radius: 20rpx; padding: 22rpx;
  border: 1rpx solid #e6edf6; box-shadow: 0 8rpx 24rpx rgba(15,42,82,0.05);
}
.stat-card .label { color: #7b8ca6; font-size: 22rpx; }
.stat-card .value { font-size: 40rpx; font-weight: 700; color: #0f2a52; margin-top: 4rpx; }

.quick-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.quick {
  flex: 1 1 28%; background: #fff; border-radius: 20rpx; padding: 24rpx 16rpx;
  border: 1rpx solid #e6edf6; text-align: center;
}
.quick .icon {
  width: 64rpx; height: 64rpx; border-radius: 18rpx; margin: 0 auto 10rpx;
  display: flex; align-items: center; justify-content: center;
  background: #eef4ff; color: #2563eb; font-size: 28rpx; font-weight: 800;
}
.quick text { font-size: 24rpx; color: #334155; }

.tabs { display: flex; gap: 12rpx; background: #eef4ff; padding: 8rpx; border-radius: 999rpx; margin-bottom: 22rpx; }
.tabs .tab { flex: 1; text-align: center; padding: 14rpx 0; border-radius: 999rpx; font-size: 25rpx; color: #64748b; }
.tabs .tab.active { background: #fff; color: #2563eb; font-weight: 700; box-shadow: 0 4rpx 14rpx rgba(37,99,235,0.12); }

.fab {
  position: fixed; right: 30rpx; bottom: 60rpx; width: 108rpx; height: 108rpx; border-radius: 50%;
  background: linear-gradient(135deg, #2f6fed, #1d4ed8); color: #fff; font-size: 24rpx;
  display: flex; align-items: center; justify-content: center; text-align: center;
  box-shadow: 0 14rpx 30rpx rgba(37,99,235,0.35); z-index: 20;
}
.modal-mask {
  position: fixed; inset: 0; background: rgba(8,22,43,0.55); z-index: 100;
  display: flex; align-items: flex-end;
}
.modal {
  background: #fff; width: 100%; border-radius: 30rpx 30rpx 0 0; padding: 32rpx 30rpx 54rpx;
  max-height: 88vh; overflow: auto;
}
.modal h2 { font-size: 34rpx; margin: 0 0 20rpx; color: #0f2a52; }
.modal-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.modal-actions .btn { flex: 1; }

.photo-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.photo-row image, .photo-add {
  width: 150rpx; height: 150rpx; border-radius: 14rpx; background: #f1f5f9;
}
.photo-add {
  display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 44rpx;
  border: 2rpx dashed #dbe5f2;
}
