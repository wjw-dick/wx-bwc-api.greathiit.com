<view class="container">
  <view class="card">
    <view class="field">
      <view class="label">原密码<text class="required">*</text></view>
      <input value="{{oldPassword}}" data-field="oldPassword" bindinput="onInput" password placeholder="请输入当前密码" />
    </view>
    <view class="field">
      <view class="label">新密码<text class="required">*</text></view>
      <input value="{{newPassword}}" data-field="newPassword" bindinput="onInput" password placeholder="8-32 位，含字母和数字" />
    </view>
    <view class="field">
      <view class="label">确认新密码<text class="required">*</text></view>
      <input value="{{confirmPassword}}" data-field="confirmPassword" bindinput="onInput" password placeholder="再次输入新密码" />
    </view>
    <view wx:if="{{error}}" class="error-text">{{error}}</view>
    <button class="btn block" loading="{{submitting}}" bindtap="submit">确认修改</button>
    <view class="hint" style="text-align:center;margin-top:14rpx;">修改成功后需重新登录，其他端登录态将失效</view>
  </view>
</view>
