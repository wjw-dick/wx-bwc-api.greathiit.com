<view class="container">
  <view class="card">
    <view class="section-title" style="margin-top:0;">车辆备案</view>
    <view class="muted" style="margin-bottom:22rpx;">提交后由保卫处审核，通过后自动下发固定车牌。</view>

    <view class="field">
      <view class="label">车牌号<text class="required">*</text></view>
      <input value="{{form.plateNo}}" data-field="plateNo" bindinput="onInput" maxlength="10" placeholder="如 京A12345" />
    </view>
    <view class="field">
      <view class="label">车主姓名<text class="required">*</text></view>
      <input value="{{form.ownerName}}" data-field="ownerName" bindinput="onInput" maxlength="30" placeholder="请输入车主姓名" />
    </view>
    <view class="field">
      <view class="label">联系电话<text class="required">*</text></view>
      <input value="{{form.phone}}" data-field="phone" bindinput="onInput" type="number" maxlength="11" placeholder="11 位手机号" />
      <view class="hint">仅保存脱敏号码，用于备案审核与门岗联系</view>
    </view>
    <view class="field">
      <view class="label">车辆类型</view>
      <picker mode="selector" range="{{vehicleTypes}}" value="{{form.vehicleTypeIndex}}" bindchange="onType">
        <view class="picker-value">{{vehicleTypes[form.vehicleTypeIndex]}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">有效期</view>
      <view class="row gap">
        <picker mode="date" value="{{form.validStart}}" data-field="validStart" bindchange="onDate" style="flex:1;">
          <view class="picker-value">{{form.validStart || '开始日期'}}</view>
        </picker>
        <picker mode="date" value="{{form.validEnd}}" data-field="validEnd" bindchange="onDate" style="flex:1;">
          <view class="picker-value">{{form.validEnd || '结束日期'}}</view>
        </picker>
      </view>
    </view>
    <view class="field">
      <view class="label">备注</view>
      <textarea value="{{form.remark}}" data-field="remark" bindinput="onInput" maxlength="200" placeholder="选填" />
    </view>
    <view wx:if="{{error}}" class="error-text">{{error}}</view>
    <button class="btn block" loading="{{submitting}}" bindtap="submit">提交备案</button>
  </view>

  <view class="section-title" style="margin-top:28rpx;">我的备案</view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无备案记录</view>
  <view wx:for="{{list}}" wx:key="id" class="list-item">
    <view class="top">
      <view class="plate">{{item.plateNo}}</view>
      <view class="tag {{item.status === 'NORMAL' || item.status === 'APPROVED' ? 'ok' : (item.status === 'REJECTED' ? 'danger' : 'warn')}}">{{item.statusText}}</view>
    </view>
    <view class="meta-line">
      <text>车主：{{item.ownerName || '-'}}</text>
      <text>类型：{{item.vehicleType || '-'}}</text>
      <text>车牌下发：{{item.authText}}</text>
    </view>
    <view wx:if="{{item.validStart || item.validEnd}}" class="meta-line">
      <text>有效期：{{item.validStart || '-'}} 至 {{item.validEnd || '-'}}</text>
    </view>
    <view wx:if="{{item.remark}}" class="muted" style="margin-top:8rpx;">{{item.remark}}</view>
  </view>
</view>
