.photo-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.photo-item { position: relative; width: 150rpx; height: 150rpx; border-radius: 14rpx; overflow: hidden; background: #eef4ff; }
.photo-item image { width: 100%; height: 100%; }
.photo-del {
  position: absolute; right: 0; top: 0; width: 40rpx; height: 40rpx; line-height: 36rpx;
  text-align: center; color: #fff; background: rgba(15, 42, 82, 0.65); border-bottom-left-radius: 12rpx;
}
.photo-add {
  width: 150rpx; height: 150rpx; border: 1rpx dashed #b9cbe4; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center; color: #2563eb; font-size: 24rpx; background: #f8fbff;
}
.meta-line { display: flex; flex-wrap: wrap; gap: 8rpx 24rpx; color: #7b8ca6; font-size: 24rpx; margin-top: 10rpx; }
