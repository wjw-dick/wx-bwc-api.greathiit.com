<view class="container">
  <view class="card">
    <view class="section-title" style="margin-top:0;">违停上报</view>
    <view class="muted" style="margin-bottom:22rpx;">发现校园内违停车辆可拍照上报，保卫处核实处理。</view>

    <view class="field">
      <view class="label">车牌号<text class="required">*</text></view>
      <input value="{{form.plateNo}}" data-field="plateNo" bindinput="onInput" maxlength="10" placeholder="如 京A12345" />
    </view>
    <view class="field">
      <view class="label">违停地点<text class="required">*</text></view>
      <input value="{{form.location}}" data-field="location" bindinput="onInput" maxlength="100" placeholder="如 图书馆消防通道" />
    </view>
    <view class="field">
      <view class="label">违停时间</view>
      <view class="row gap">
        <picker mode="date" value="{{form.violateDate}}" data-field="violateDate" bindchange="onDate" style="flex:1;">
          <view class="picker-value">{{form.violateDate || '选择日期'}}</view>
        </picker>
        <picker mode="time" value="{{form.violateClock}}" data-field="violateClock" bindchange="onDate" style="flex:1;">
          <view class="picker-value">{{form.violateClock || '选择时间'}}</view>
        </picker>
      </view>
    </view>
    <view class="field">
      <view class="label">违停描述</view>
      <textarea value="{{form.description}}" data-field="description" bindinput="onInput" maxlength="300" placeholder="如：占用消防通道，车主不在现场" />
    </view>
    <view class="field">
      <view class="label">现场照片</view>
      <view class="photo-row">
        <view wx:for="{{form.photos}}" wx:key="*this" class="photo-item">
          <image src="{{item}}" mode="aspectFill" />
          <view class="photo-del" data-index="{{index}}" bindtap="removePhoto">×</view>
        </view>
        <view wx:if="{{form.photos.length < 3}}" class="photo-add" bindtap="choosePhoto">
          <text>{{uploading ? '上传中' : '+ 拍照'}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{error}}" class="error-text">{{error}}</view>
    <button class="btn block" loading="{{submitting}}" bindtap="submit">提交上报</button>
  </view>

  <view class="section-title" style="margin-top:28rpx;">我的上报</view>
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty">暂无上报记录</view>
  <view wx:for="{{list}}" wx:key="id" class="list-item">
    <view class="top">
      <view style="font-weight:700;color:#0f2a52;">{{item.plateNo}}</view>
      <view class="tag {{item.handleStatus === 'DONE' ? 'ok' : 'warn'}}">{{item.statusText}}</view>
    </view>
    <view class="meta-line"><text>{{item.location}}</text><text>{{item.violateTime}}</text></view>
    <view wx:if="{{item.description}}" class="muted" style="margin-top:8rpx;">{{item.description}}</view>
    <view wx:if="{{item.handleResult}}" class="muted" style="margin-top:8rpx;">处理结果：{{item.handleResult}}</view>
  </view>
</view>
