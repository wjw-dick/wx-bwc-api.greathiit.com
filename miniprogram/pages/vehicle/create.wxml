<view class="container">
  <view wx:if="{{success}}">
    <view class="card" style="text-align:center;padding:50rpx 30rpx;">
      <view style="font-size:70rpx;">🚗</view>
      <view class="title" style="margin-top:12rpx;">车辆预约已提交</view>
      <view class="muted" style="margin-top:8rpx;">审批通过后车牌将自动下发至道闸白名单</view>
      <view class="result">
        <view class="result-row"><text>车牌号</text><text>{{result.plateNo}}</text></view>
        <view class="result-row"><text>驾驶人</text><text>{{result.visitorName}}</text></view>
        <view class="result-row"><text>联系电话</text><text>{{result.phoneMask || '-'}}</text></view>
        <view class="result-row"><text>入校时间</text><text>{{result.visitTime || '-'}}</text></view>
        <view class="result-row"><text>审批状态</text><text>待审批</text></view>
      </view>
    </view>
    <button class="btn block" bindtap="goQuery">查询预约进度</button>
    <button class="btn block ghost" style="margin-top:18rpx;" bindtap="goBack">返回</button>
  </view>

  <view wx:else>
    <view class="card">
      <view class="field">
        <view class="label">车牌号<text class="required">*</text></view>
        <input value="{{form.plateNo}}" data-field="plateNo" bindinput="onInput" placeholder="如 京A12345" maxlength="10" />
        <view class="hint">支持新能源 8 位车牌，提交后自动大写</view>
      </view>
      <view class="field">
        <view class="label">驾驶人姓名<text class="required">*</text></view>
        <input value="{{form.visitorName}}" data-field="visitorName" bindinput="onInput" placeholder="请输入驾驶人姓名" maxlength="30" />
      </view>
      <view class="field">
        <view class="label">联系电话<text class="required">*</text></view>
        <input value="{{form.phone}}" data-field="phone" bindinput="onInput" type="number" maxlength="11" placeholder="11 位手机号" />
        <view class="hint">仅保存脱敏号码，用于门岗核验</view>
      </view>
      <view class="field">
        <view class="label">来访事由<text class="required">*</text></view>
        <picker mode="selector" range="{{reasons}}" value="{{form.reasonIndex}}" bindchange="onReason">
          <view class="picker-value">{{reasons[form.reasonIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">入校时间<text class="required">*</text></view>
        <view class="row gap">
          <picker mode="date" value="{{form.visitDate}}" data-field="visitDate" bindchange="onDate" style="flex:1;">
            <view class="picker-value">{{form.visitDate || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{form.visitClock}}" data-field="visitClock" bindchange="onDate" style="flex:1;">
            <view class="picker-value">{{form.visitClock || '选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <view class="label">离校时间</view>
        <view class="row gap">
          <picker mode="date" value="{{form.leaveDate}}" data-field="leaveDate" bindchange="onDate" style="flex:1;">
            <view class="picker-value">{{form.leaveDate || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{form.leaveClock}}" data-field="leaveClock" bindchange="onDate" style="flex:1;">
            <view class="picker-value">{{form.leaveClock || '选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <view class="label">备注</view>
        <textarea value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="选填" maxlength="200" />
      </view>
      <view wx:if="{{error}}" class="error-text">{{error}}</view>
      <button class="btn block" loading="{{submitting}}" bindtap="submit">提交预约</button>
      <view class="muted" style="text-align:center;margin-top:18rpx;" bindtap="goQuery">已有预约？查询进度 ›</view>
    </view>
  </view>
</view>
