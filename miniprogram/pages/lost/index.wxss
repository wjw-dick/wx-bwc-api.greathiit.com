.search-card { padding: 20rpx 22rpx; }
.search-row { display: flex; align-items: center; gap: 14rpx; }
.search-row input {
  flex: 1; height: 72rpx; line-height: 72rpx; background: #f6f9fe; border: 1rpx solid #dbe5f2; border-radius: 999rpx;
  padding: 0 24rpx; font-size: 26rpx; box-sizing: border-box;
}
.chips { white-space: nowrap; margin-top: 16rpx; }
.chip {
  display: inline-block; padding: 8rpx 24rpx; margin-right: 12rpx;
  background: #eef4ff; color: #64748b; border-radius: 999rpx; font-size: 24rpx;
}
.chip.active { background: #2563eb; color: #fff; }

.lost-card {
  display: flex; gap: 20rpx; background: #fff; border-radius: 20rpx; padding: 20rpx;
  border: 1rpx solid #e6edf6; margin-bottom: 16rpx; align-items: center;
}
.thumb { width: 132rpx; height: 132rpx; border-radius: 16rpx; background: #eef4ff; flex-shrink: 0; }
.thumb-placeholder {
  display: flex; align-items: center; justify-content: center;
  color: #2563eb; font-size: 24rpx; font-weight: 700;
}
.lost-name { font-size: 30rpx; font-weight: 700; color: #0f2a52; }
.card-actions {
  display: flex; align-items: center; justify-content: space-between; gap: 12rpx;
  margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx dashed #eef3fa;
}
