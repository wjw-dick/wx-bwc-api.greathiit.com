<view class="container">
  <view class="tabs">
    <view class="tab {{tab === 'wall' ? 'active' : ''}}" data-tab="wall" bindtap="switchTab">失物墙</view>
    <view class="tab {{tab === 'claims' ? 'active' : ''}}" data-tab="claims" bindtap="switchTab">我的认领</view>
  </view>

  <block wx:if="{{tab === 'wall'}}">
    <view class="card search-card">
      <view class="search-row">
        <input value="{{keyword}}" bindinput="onKeyword" bindconfirm="search" placeholder="搜索物品名称 / 地点" confirm-type="search" />
        <view class="btn small" bindtap="search">搜索</view>
      </view>
      <scroll-view scroll-x class="chips">
        <view wx:for="{{categories}}" wx:key="value" class="chip {{category === item.value ? 'active' : ''}}"
          data-value="{{item.value}}" bindtap="onCategory">{{item.label}}</view>
      </scroll-view>
    </view>

    <view wx:if="{{loading && !list.length}}" class="loading">加载中…</view>
    <view wx:elif="{{!list.length}}" class="empty">暂未找到相关失物，可点击右下角登记拾获物品</view>

    <view wx:for="{{list}}" wx:key="id" class="lost-card" data-id="{{item.id}}" bindtap="openDetail">
      <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="thumb" />
      <view wx:else class="thumb thumb-placeholder">{{item.categoryLabel}}</view>
      <view class="flex1">
        <view class="between">
          <view class="lost-name">{{item.name}}</view>
          <view class="tag {{item.status === 'CLAIMED' ? 'ok' : ''}}">{{item.statusText}}</view>
        </view>
        <view class="muted" style="margin-top:6rpx;">{{item.categoryLabel}} · {{item.location || '地点待补充'}}</view>
        <view wx:if="{{item.finderPhoneMask}}" class="muted" style="font-size:22rpx;margin-top:2rpx;">拾获人手机号：{{item.finderPhoneMask}}</view>
        <view class="muted" style="font-size:22rpx;margin-top:4rpx;">拾获时间：{{item.foundTimeText}}</view>
        <view class="card-actions">
          <text class="muted" style="font-size:22rpx;">拾获人：{{item.finder || '热心师生'}}</text>
          <view wx:if="{{item.status === 'FOUND' || item.status === 'PUBLISHED'}}" class="btn small" data-id="{{item.id}}" catchtap="goClaim">申请认领</view>
          <view wx:else class="tag ok">已认领</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!loggedIn}}" class="card" style="text-align:center;padding:60rpx 30rpx;">
      <view style="font-size:60rpx;">🔐</view>
      <view class="title" style="margin-top:12rpx;">登录后查看认领进度</view>
      <button class="btn" style="margin-top:24rpx;" bindtap="goLogin">立即登录</button>
    </view>
    <view wx:elif="{{!claims.length}}" class="empty">暂无认领申请，可在失物墙选择物品申请认领</view>
    <view wx:for="{{claims}}" wx:key="id" class="list-item">
      <view class="top">
        <h3>认领编号 #{{item.id}}</h3>
        <view class="tag {{item.statusClass}}">{{item.statusText}}</view>
      </view>
      <view class="meta-line">
        <view>认领人：{{item.claimant}}</view>
        <view>手机：{{item.phoneMask || '-'}}</view>
        <view>申请时间：{{item.claimTimeText}}</view>
      </view>
      <view wx:if="{{item.remark}}" class="muted" style="margin-top:8rpx;">{{item.remark}}</view>
    </view>
  </block>
</view>

<view class="fab" bindtap="goReport">＋<br/>登记</view>
