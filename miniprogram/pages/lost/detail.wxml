<view class="container">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{!item}}" class="empty">物品不存在或已下架</view>

  <block wx:else>
    <view class="card">
      <view class="between">
        <view class="title">{{item.name}}</view>
        <view class="tag {{item.status === 'CLAIMED' ? 'ok' : ''}}">{{item.statusText}}</view>
      </view>
      <view class="muted" style="margin-top:8rpx;">{{item.categoryLabel}} · 编号 {{item.itemNo || '-'}}</view>

      <view wx:if="{{item.photos.length}}" class="photo-row" style="margin-top:22rpx;">
        <image wx:for="{{item.photos}}" wx:key="*this" wx:for-item="photo" src="{{photo}}" mode="aspectFill"
          data-src="{{photo}}" bindtap="preview" />
      </view>

      <view class="divider"></view>
      <view class="detail-row"><text>拾获地点</text><text>{{item.location || '-'}}</text></view>
      <view class="detail-row"><text>拾获时间</text><text>{{item.foundTimeText}}</text></view>
      <view class="detail-row"><text>保管地点</text><text>{{item.storageLocation || '保卫处失物招领点'}}</text></view>
      <view class="detail-row"><text>拾获人</text><text>{{item.finder || '热心师生'}}</text></view>
      <view class="detail-row"><text>拾获人手机号</text><text>{{item.finderPhoneMask || '-'}}</text></view>
      <view class="detail-block">
        <view class="muted">物品描述</view>
        <view style="margin-top:8rpx;">{{item.description || '暂无详细描述'}}</view>
      </view>
    </view>

    <view class="card tip-card">
      <view style="font-weight:700;color:#0f2a52;">认领须知</view>
      <view class="muted" style="margin-top:8rpx;">请如实填写身份信息，认领时需携带有效证件原件；身份证号仅加密存储并以脱敏形式展示。</view>
    </view>

    <button wx:if="{{item.status !== 'CLAIMED' && item.status !== 'DISPOSED'}}" class="btn block" bindtap="openClaim">申请认领</button>
    <view wx:else class="empty" style="padding:20rpx 0;">该物品已完成认领或处置</view>
  </block>
</view>

<view wx:if="{{claimVisible}}" class="modal-mask" bindtap="closeClaim">
  <view class="modal" catchtap="noop">
    <h2>申请认领</h2>
    <view class="field">
      <view class="label">认领人姓名<text class="required">*</text></view>
      <input value="{{claimForm.claimant}}" data-field="claimant" bindinput="onInput" placeholder="请输入姓名" maxlength="30" />
    </view>
    <view class="field">
      <view class="label">手机号<text class="required">*</text></view>
      <input value="{{claimForm.phone}}" data-field="phone" bindinput="onInput" type="number" maxlength="11" placeholder="11 位手机号" />
    </view>
    <view class="field">
      <view class="label">身份证号</view>
      <input value="{{claimForm.idCard}}" data-field="idCard" bindinput="onInput" maxlength="18" placeholder="选填，用于身份核验" />
      <view class="hint">加密存储{{idCardMask ? '，脱敏：' + idCardMask : ''}}</view>
    </view>
    <view class="field">
      <view class="label">物品特征描述</view>
      <textarea value="{{claimForm.remark}}" data-field="remark" bindinput="onInput" maxlength="200" placeholder="描述物品特征，便于核验" />
    </view>
    <view wx:if="{{error}}" class="error-text">{{error}}</view>
    <view class="modal-actions">
      <button class="btn outline" bindtap="closeClaim">取消</button>
      <button class="btn" loading="{{submitting}}" bindtap="submitClaim">提交申请</button>
    </view>
  </view>
</view>
