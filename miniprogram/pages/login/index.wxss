.login-page { min-height: 100vh; padding: 80rpx 44rpx; background: linear-gradient(160deg, #eef4ff 0%, #f6f9fe 45%); box-sizing: border-box; }
.brand { display: flex; align-items: center; gap: 18rpx; position: relative; }
.logo {
  width: 84rpx; height: 84rpx; border-radius: 22rpx; color: #fff; font-weight: 800; font-size: 38rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #2f6fed, #0f2a52);
}
.brand-text .name { font-size: 34rpx; font-weight: 800; color: #0f2a52; }
.brand-text .en { font-size: 20rpx; color: #7b8ca6; letter-spacing: 2rpx; }
.lang {
  position: absolute; right: 0; top: 10rpx; font-size: 22rpx; color: #2563eb;
  border: 1rpx solid #dbe5f2; background: #fff; border-radius: 999rpx; padding: 6rpx 20rpx;
}
.title { font-size: 48rpx; font-weight: 800; color: #0f2a52; margin-top: 70rpx; }
.subtitle { color: #7b8ca6; font-size: 25rpx; margin-top: 10rpx; }
.form { margin-top: 36rpx; padding: 34rpx 30rpx; }
.hint { color: #94a3b8; font-size: 22rpx; line-height: 1.6; margin-top: 18rpx; text-align: center; }
.footer { margin-top: 70rpx; text-align: center; color: #94a3b8; font-size: 21rpx; line-height: 1.9; }
