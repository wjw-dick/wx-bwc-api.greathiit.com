<view class="container">
  <view wx:if="{{!loggedIn}}" class="card" style="text-align:center;padding:60rpx 30rpx;">
    <view style="font-size:60rpx;">🔔</view>
    <view class="title" style="margin-top:12rpx;">登录后查看消息</view>
    <view class="subtitle">审批结果、预警推送与系统通知</view>
    <button class="btn" style="margin-top:24rpx;" bindtap="goLogin">立即登录</button>
  </view>

  <block wx:else>
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="value" class="tab {{tab === item.value ? 'active' : ''}}"
        data-value="{{item.value}}" bindtap="switchTab">{{item.label}}</view>
    </view>

    <view class="between" style="margin-bottom:16rpx;">
      <view class="muted">共 {{total}} 条消息</view>
      <view class="tag warn">{{unread}} 条未读</view>
    </view>

    <view wx:if="{{loading && !list.length}}" class="loading">加载中…</view>
    <view wx:elif="{{!list.length}}" class="empty">暂无消息</view>
    <view wx:for="{{list}}" wx:key="id" class="message-card" data-id="{{item.id}}" bindtap="open">
      <view class="between">
        <view class="msg-title">{{item.title}}</view>
        <view class="tag {{item.readClass}}">{{item.readText}}</view>
      </view>
      <view class="muted msg-content">{{item.content}}</view>
      <view class="muted" style="font-size:22rpx;margin-top:6rpx;">{{item.timeText}} · {{item.bizType || 'SYSTEM'}}</view>
    </view>
  </block>
</view>

<view wx:if="{{detailVisible}}" class="modal-mask" bindtap="closeDetail">
  <view class="modal" catchtap="noop">
    <h2>{{detail.title}}</h2>
    <view class="muted" style="margin-bottom:16rpx;">{{detail.timeText}}</view>
    <view style="white-space:pre-wrap;">{{detail.content}}</view>
    <button class="btn ghost" style="margin-top:24rpx;" bindtap="closeDetail">关闭</button>
  </view>
</view>
