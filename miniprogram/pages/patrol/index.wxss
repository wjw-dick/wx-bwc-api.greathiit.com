.point-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.point {
  flex: 1 1 30%; padding: 20rpx 12rpx; border-radius: 16rpx; border: 1rpx solid #dbe5f2;
  background: #fbfdff; text-align: center; font-size: 25rpx; color: #334155;
}
.point.active { border-color: #9dc3fa; background: #eef6ff; color: #2563eb; font-weight: 700; }
.point .time { display: block; font-size: 20rpx; color: #94a3b8; margin-top: 4rpx; font-weight: 400; }
