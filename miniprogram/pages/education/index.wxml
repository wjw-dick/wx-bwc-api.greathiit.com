<view class="container">
  <view wx:if="{{!loggedIn}}" class="card" style="text-align:center;padding:60rpx 30rpx;">
    <view style="font-size:60rpx;">📚</view>
    <view class="title" style="margin-top:12rpx;">登录后参与安全教育</view>
    <view class="subtitle">在线课程、安全考试与成绩记录</view>
    <button class="btn" style="margin-top:24rpx;" bindtap="goLogin">立即登录</button>
  </view>

  <block wx:else>
    <view class="tabs">
      <view class="tab {{tab === 'course' ? 'active' : ''}}" data-tab="course" bindtap="switchTab">课程</view>
      <view class="tab {{tab === 'exam' ? 'active' : ''}}" data-tab="exam" bindtap="switchTab">考试</view>
      <view class="tab {{tab === 'record' ? 'active' : ''}}" data-tab="record" bindtap="switchTab">成绩</view>
    </view>

    <view wx:if="{{loading && !courses.length}}" class="loading">加载中…</view>

    <block wx:if="{{tab === 'course'}}">
      <view wx:if="{{!courses.length}}" class="empty">暂未发布课程</view>
      <view wx:for="{{courses}}" wx:key="id" class="card course-card">
        <view class="between">
          <view class="title" style="font-size:30rpx;">{{item.title}}</view>
          <view class="tag">{{item.category || '安全教育'}}</view>
        </view>
        <view class="muted" style="margin-top:8rpx;">发布于 {{item.publishTimeText}}</view>
        <view class="muted preview-text" style="margin-top:10rpx;">{{item.content}}</view>
        <view class="row gap" style="margin-top:18rpx;justify-content:flex-end;">
          <view class="btn small ghost" data-id="{{item.id}}" bindtap="openCourse">查看</view>
          <view class="btn small" data-id="{{item.id}}" bindtap="study">标记已学</view>
        </view>
      </view>
    </block>

    <block wx:elif="{{tab === 'exam'}}">
      <view wx:if="{{!exams.length}}" class="empty">暂未发布考试</view>
      <view wx:for="{{exams}}" wx:key="id" class="card">
        <view class="between">
          <view class="title" style="font-size:30rpx;">{{item.title}}</view>
          <view class="tag warn">满分 {{item.totalScore}}</view>
        </view>
        <view class="meta-line">
          <view>及格线：{{item.passScore}} 分</view>
          <view>{{item.timeText}}</view>
        </view>
        <view class="row gap" style="margin-top:18rpx;justify-content:flex-end;">
          <view class="btn small" data-id="{{item.id}}" bindtap="goExam">开始考试</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{!records.length}}" class="empty">暂无考试成绩</view>
      <view wx:for="{{records}}" wx:key="id" class="list-item">
        <view class="top">
          <h3>考试 #{{item.examId}}</h3>
          <view class="tag {{item.passClass}}">{{item.passText}}</view>
        </view>
        <view class="meta-line">
          <view>得分：{{item.score}}</view>
          <view>提交：{{item.submitTimeText}}</view>
        </view>
      </view>
    </block>
  </block>
</view>

<view wx:if="{{detailVisible}}" class="modal-mask" bindtap="closeDetail">
  <view class="modal" catchtap="noop">
    <h2>{{detail.title}}</h2>
    <view class="muted" style="margin-bottom:16rpx;">{{detail.category || '安全教育'}} · {{detail.publishTimeText}}</view>
    <rich-text nodes="{{detail.content}}"></rich-text>
    <button class="btn ghost" style="margin-top:24rpx;" bindtap="closeDetail">关闭</button>
  </view>
</view>
