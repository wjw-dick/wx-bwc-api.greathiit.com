<view class="container">
  <view wx:if="{{success}}">
    <view class="card" style="text-align:center;padding:50rpx 30rpx;">
      <view style="font-size:70rpx;">✅</view>
      <view class="title" style="margin-top:12rpx;">预约已提交</view>
      <view class="muted" style="margin-top:8rpx;">请等待被访人审批，通过后凭通行码入校</view>
      <view class="result">
        <view class="result-row"><text>访客</text><text>{{result.visitorName}}</text></view>
        <view class="result-row"><text>手机号</text><text>{{result.phoneMask || '-'}}</text></view>
        <view class="result-row"><text>身份证</text><text>{{result.idCardMask || '-'}}</text></view>
        <view class="result-row"><text>来访时间</text><text>{{result.visitTime || '-'}}</text></view>
        <view class="result-row"><text>状态</text><text>待审批</text></view>
      </view>
      <view class="muted" style="font-size:22rpx;margin-top:18rpx;">身份证号加密存储，页面仅展示脱敏信息</view>
    </view>
    <button class="btn block" bindtap="goList">查看我的预约</button>
    <button class="btn block ghost" style="margin-top:18rpx;" bindtap="again">再次预约</button>
  </view>

  <view wx:else>
    <view class="card">
      <view class="field">
        <view class="label">访客姓名<text class="required">*</text></view>
        <input value="{{form.visitorName}}" data-field="visitorName" bindinput="onInput" placeholder="请输入访客姓名" maxlength="30" />
      </view>
      <view class="field">
        <view class="label">手机号<text class="required">*</text></view>
        <input value="{{form.phone}}" data-field="phone" bindinput="onInput" type="number" maxlength="11" placeholder="11 位手机号" />
      </view>
      <view class="field">
        <view class="label">身份证号</view>
        <input value="{{form.idCard}}" data-field="idCard" bindinput="onInput" maxlength="18" placeholder="选填，仅用于身份核验" />
        <view class="hint">加密存储，提交后仅展示脱敏信息{{idCardMask ? '：' + idCardMask : ''}}</view>
      </view>
      <view class="field">
        <view class="label">来访事由<text class="required">*</text></view>
        <picker mode="selector" range="{{reasons}}" value="{{form.reasonIndex}}" bindchange="onReason">
          <view class="picker-value">{{reasons[form.reasonIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="label">来访时间<text class="required">*</text></view>
        <view class="row gap">
          <picker mode="date" value="{{form.visitDate}}" data-field="visitDate" bindchange="onDate" style="flex:1;">
            <view class="picker-value">{{form.visitDate || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{form.visitClock}}" data-field="visitClock" bindchange="onDate" style="flex:1;">
            <view class="picker-value">{{form.visitClock || '选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <view class="label">离校时间</view>
        <view class="row gap">
          <picker mode="date" value="{{form.leaveDate}}" data-field="leaveDate" bindchange="onDate" style="flex:1;">
            <view class="picker-value">{{form.leaveDate || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{form.leaveClock}}" data-field="leaveClock" bindchange="onDate" style="flex:1;">
            <view class="picker-value">{{form.leaveClock || '选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="field">
        <view class="label">被访人</view>
        <input value="{{form.visitUserName}}" data-field="visitUserName" bindinput="onInput" placeholder="被访人姓名" maxlength="30" />
      </view>
      <view class="field">
        <view class="label">随行人数</view>
        <input value="{{form.accompanyCount}}" data-field="accompanyCount" bindinput="onInput" type="number" placeholder="0" />
      </view>
      <view class="field">
        <view class="label">车牌号</view>
        <input value="{{form.plateNo}}" data-field="plateNo" bindinput="onInput" placeholder="选填，如 京A12345" maxlength="10" />
      </view>
      <view class="field">
        <view class="label">备注</view>
        <textarea value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="选填" maxlength="200" />
      </view>
      <view wx:if="{{error}}" class="error-text">{{error}}</view>
      <button class="btn block" loading="{{submitting}}" bindtap="submit">提交预约</button>
    </view>
  </view>
</view>
