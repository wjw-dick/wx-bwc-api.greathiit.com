<view class="container">
  <view wx:if="{{!loggedIn}}" class="card" style="text-align:center;padding:60rpx 30rpx;">
    <view style="font-size:60rpx;">📋</view>
    <view class="title" style="margin-top:12rpx;">登录后处理审批</view>
    <view class="subtitle">访客、车辆、失物认领、报备与监控调取</view>
    <button class="btn" style="margin-top:24rpx;" bindtap="goLogin">立即登录</button>
  </view>

  <block wx:else>
    <view class="stat-grid" style="margin-top:0;">
      <view class="stat-card">
        <view class="label">待办总数</view>
        <view class="value">{{total}}</view>
      </view>
      <view class="stat-card">
        <view class="label">访客 / 车辆</view>
        <view class="value">{{stats.visitor}} / {{stats.vehicle}}</view>
      </view>
      <view class="stat-card">
        <view class="label">认领 / 报备</view>
        <view class="value">{{stats.claim}} / {{stats.report}}</view>
      </view>
      <view class="stat-card">
        <view class="label">监控调取</view>
        <view class="value">{{stats.monitor}}</view>
      </view>
    </view>

    <view class="card" style="margin-top:16rpx;background:#f8fbff;text-align:center;" bindtap="subscribeNotice">
      <view class="muted">开启审批与事件订阅提醒</view>
    </view>

    <view wx:if="{{loading && !groups.length}}" class="loading">加载中…</view>
    <view wx:elif="{{!groups.length}}" class="empty">暂无待办审批，辛苦了</view>

    <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
      <view class="section-title" style="margin-top:28rpx;">{{group.name}}（{{group.items.length}}）</view>
      <view wx:for="{{group.items}}" wx:key="id" class="list-item">
        <view class="top">
          <h3>{{item.title}}</h3>
          <view class="tag warn">待审批</view>
        </view>
        <view class="meta-line">
          <view>{{item.subtitle}}</view>
        </view>
        <view wx:if="{{item.extra}}" class="muted" style="margin-top:6rpx;">{{item.extra}}</view>
        <view wx:if="{{group.key !== 'monitor'}}" class="row gap" style="margin-top:18rpx;justify-content:flex-end;">
          <view class="btn small danger" data-kind="{{group.key}}" data-id="{{item.id}}" data-approved="false" bindtap="act">驳回</view>
          <view class="btn small" data-kind="{{group.key}}" data-id="{{item.id}}" data-approved="true" bindtap="act">通过</view>
        </view>
        <view wx:else class="muted" style="margin-top:10rpx;">监控调取需在管理端完成两级审批</view>
      </view>
    </block>

    <view class="card" style="margin-top:20rpx;background:#f8fbff;text-align:center;" bindtap="goHome">
      <view class="muted">返回首页</view>
    </view>
  </block>
</view>
